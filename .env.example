# Telegram
TELEGRAM_BOT_TOKEN=
# Cadena aleatoria larga (la inventas tú). Protege el webhook y la URL de /api/setup
TELEGRAM_WEBHOOK_SECRET=
# Tu ID de Telegram (lo da el comando /miid). Varios separados por comas
ADMIN_TELEGRAM_IDS=
# true: el comercial puede usar el bot también en privado (se registra todo igual)
PRIVATE_CHAT_ENABLED=true

# Claude
ANTHROPIC_API_KEY=
# Opcional
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pipedrive
PIPEDRIVE_DOMAIN=leaseir.pipedrive.com
PIPEDRIVE_API_TOKEN=

# Postgres (Neon desde el Marketplace de Vercel la rellena sola)
DATABASE_URL=

# Cadena aleatoria; Vercel la usa para firmar la llamada del cron
CRON_SECRET=
